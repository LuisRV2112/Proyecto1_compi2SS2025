## Herencia, encapsulamiento, @Override y super ##
import herencia.Animal.z
import herencia.Perro.z
import herencia.Gato.z

VARIABILES>
esto a : novus Animal("Toby");
esto p : novus Perro("Firulais");
esto g : novus Gato("Misifu");

MAIOR>
a.comer();
p.comer();
p.ladrar();
g.comer();
>> g.ficha();
FINIS;
